# ==============================================================================
# Local development configuration. Copy to .env and edit.
# In Cloud Run these are supplied by Terraform, not by this file.
# ==============================================================================

# --- Google Cloud -------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id

# Region where the Cloud Run Job executes.
GCP_REGION=us-central1

# BigQuery dataset LOCATION. This is deliberately NOT the same as GCP_REGION.
# bigquery-public-data lives in the US multi-region and BigQuery cannot join
# across locations, so setting this to us-central1 breaks the seed step.
BQ_LOCATION=US

# --- BigQuery objects ---------------------------------------------------------
BQ_DATASET_ID=ml_production
MODEL_NAME=taxi_tip_model
FEATURES_TABLE=taxi_trips_features
FEATURE_VIEW=v_taxi_features
PREDICTIONS_TABLE=taxi_predictions

# --- Windows ------------------------------------------------------------------
# Partition to score. Leave blank for yesterday (UTC). Set explicitly to backfill.
TARGET_DATE=

# PSI reference window. Should match the training window.
BASELINE_START_DATE=2022-01-01
BASELINE_END_DATE=2022-01-15

# How many days labels take to mature. 0 for taxi tips (known at trip
# completion). Raise for churn, chargebacks, credit default, etc.
EVAL_LABEL_LAG_DAYS=0

# --- Guardrails ---------------------------------------------------------------
# PSI convention: <0.10 none, 0.10-0.25 moderate, >0.25 significant.
PSI_DRIFT_THRESHOLD=0.25
CANARY_FEATURE=fare_amount
MIN_HOLDOUT_ROC_AUC=0.60

# Minimum plausible row count for the target partition. A bare zero-row check
# only catches total absence, not a partially failed upstream load.
MIN_ROW_COUNT=1

# --- Demo ingestion (Phase 0) -------------------------------------------------
# SET THIS TO false IN ANY REAL DEPLOYMENT.
#
# This pipeline scores a partition; it does not own ingestion. In production your
# upstream ETL lands the partition and this pipeline's preflight check fails loudly
# if it is missing. That is the correct behaviour.
#
# But this demo reads a frozen public dataset, so `make seed` alone would only ever
# populate one partition and every scheduled run from day two onward would halt with
# InsufficientDataException. Phase 0 exists purely so the demo survives past day one:
# when the target partition is absent, it synthesizes one from the public dataset.
ENABLE_DEMO_INGESTION=true

# The public dataset stores ONE TABLE PER YEAR: tlc_yellow_trips_YYYY.
# Verified populated for 2011-2022, all sharing an identical 20-column schema.
#
# WARNING: tlc_yellow_trips_2023 EXISTS but is EMPTY (0 rows, 19 columns -- it is
# missing airport_fee). Pointing at it looks reasonable and silently yields nothing.
DEMO_SOURCE_TABLE=bigquery-public-data.new_york_taxi_trips.tlc_yellow_trips_2022

# The historical window Phase 0 cycles through. The target date is mapped onto it
# with a modulo, so the demo never runs out of source data.
#
# The YEAR here must match the year in DEMO_SOURCE_TABLE. Config validation
# enforces this at startup rather than letting you discover it as a mysterious
# "partition has 0 rows" error two phases later.
DEMO_SOURCE_WINDOW_START=2022-02-01
DEMO_SOURCE_WINDOW_DAYS=28

# --- Observability ------------------------------------------------------------
ENABLE_CLOUD_EXPORTERS=true

# Must stay above 10000. Cloud Monitoring rejects two points for the same time
# series within 5 seconds, and a short interval collides with the shutdown flush.
METRIC_EXPORT_INTERVAL_MILLIS=60000
